# ── Application ──
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
APP_DEBUG=true
# Production requires two unique secrets of at least 32 UTF-8 bytes.
APP_SECRET_KEY=change-me-to-a-secure-random-string
# Plain-HTTP LAN and Tailscale clients call the backend from the station hostname,
# so this example keeps a wildcard. The public HTTPS build is same-origin and does
# not use CORS. Narrow this list where practical; never expose port 8000 publicly.
APP_CORS_ORIGINS=["*"]
# Trust the local reverse proxy so audit logs record the visitor IP.
TRUSTED_PROXIES=["127.0.0.1","::1"]

# Manual Scan Logs labels (official Windows driver; 1-10 labels per request).
BANANAVISION_PRINTER_NAME=TP870 S
BANANAVISION_LABEL_WIDTH_MM=40
BANANAVISION_LABEL_HEIGHT_MM=30
# Enable one automatic label after a real scan has committed (demo does not need this).
BANANAVISION_AUTO_PRINT=false

# ── Database ──
DATABASE_URL=postgresql+asyncpg://bv_user:bv_pass@localhost:5432/bananavision
DATABASE_ECHO=false

# ── Authentication ──
# Production requires a unique secret of at least 32 UTF-8 bytes.
JWT_SECRET_KEY=your-jwt-secret-key-here
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=480
# On an empty database, set a unique temporary password (12-72 UTF-8 bytes).
# Remove this secret after the bootstrap administrator replaces it at first login.
BOOTSTRAP_ADMIN_USERNAME=admin
# BOOTSTRAP_ADMIN_PASSWORD=

# ── Camera Configuration ──
# Hardware device indices (e.g., /dev/video1). Order determines logical IDs: CAM-001, CAM-002, etc.
CAMERA_DEVICE_IDS=[0,1,2,3]
CAMERA_LABELS=["Top","Left","Right","Rear"]
CAMERA_RESOLUTION_W=1280
CAMERA_RESOLUTION_H=720
CAMERA_WARMUP_FRAMES=30
CAMERA_CAPTURE_TIMEOUT_MS=3000
# Preserve driver focus on fixed-focus webcams such as Rapoo XW180.
# For a supported electronic focus control, set autofocus true or explicit manual false/value.
CAMERA_AUTOFOCUS=None
CAMERA_MANUAL_FOCUS_VALUE=None
CAMERA_AUTO_WHITE_BALANCE=true
CAMERA_AUTO_EXPOSURE=true
# Windows: auto selects DirectShow. Use msmf only if required by your camera driver.
CAMERA_BACKEND=auto
CAMERA_FOURCC=MJPG
CAMERA_FPS=15
CAMERA_PREVIEW_MAX_WIDTH=1280
CAMERA_PREVIEW_MAX_HEIGHT=720
CAMERA_PREVIEW_JPEG_QUALITY=90
CAMERA_CAPTURE_JPEG_QUALITY=95
# Existing stations use the saved System Configuration camera slots, not these initial IDs.
# Add all four slots and assign their device indices there; verify previews after saving.

# ── Sensor (Arduino DHT22) ──
SENSOR_SERIAL_PORT=/dev/ttyUSB0
SENSOR_BAUD_RATE=9600
SENSOR_READ_INTERVAL_S=5

# ── ML Models ──
YOLO_MODEL_PATH=app/ml/weights/banana_yolo26m.pt
YOLO_CONFIDENCE_THRESHOLD=0.50
YOLO_IOU_THRESHOLD=0.45
# YOLO26 detection head: one_to_many_nms (measured default), one_to_one (NMS-free) or
# checkpoint (whatever the weights and Ultralytics version default to).
YOLO_INFERENCE_HEAD=one_to_many_nms
# Finger-count rules; false restores the earlier behaviour (see docs/knowledge/AI Models.md).
YOLO_AXIS_AWARE_ROTATION_DEDUP=true
YOLO_HAND_BOX_SPLIT=true
YOLO_RIPENESS_OUTLIER_FILTER=true
YOLO_RECOVERY_WITHIN_HAND=true
YOLO_SIDE_VIEW_LIP_FILTER=true
# Boxes whose centre is mostly dark background or the bluish-grey cut crown are dropped
# (and the scan flagged) when this share of non-banana colour is reached.
YOLO_COLOUR_CHECK=true
YOLO_COLOUR_CHECK_MAX_NON_BANANA=0.55
YOLO_RECOVERY_ADJACENT_RIPENESS=false
RFR_MODEL_PATH=app/ml/weights/spoilage_rfr.joblib

# ── Out-of-distribution rejection (see docs/knowledge/AI Models.md) ──
# A camera view shows a banana when the general detector reaches this confidence.
OOD_BANANA_CONFIDENCE=0.30
# Weaker banana evidence still supports cultivar boxes inside its region.
OOD_SUPPORT_CONFIDENCE=0.05
OOD_SUPPORT_MARGIN=0.25
# false keeps every cultivar box of an accepted scan (the behaviour before the gate).
OOD_BOX_SUPPORT_FILTER=true
# Captured camera views that must show a banana before a scan is classified (capped at
# the number of frames captured; a scan with a missing capture is flagged for review).
OOD_MIN_BANANA_VIEWS=1
# true classifies scans even while the banana verifier cannot run. Not recommended.
OOD_GATE_FAIL_OPEN=false

# ── Storage ──
CAPTURE_DIR=captures
MAX_CAPTURES_RETENTION_DAYS=30
