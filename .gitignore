# JetBrains IDE
.idea/

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Node modules (for frontend and backend)
node_modules/
frontend/node_modules/
backend/node_modules/

# macOS system files
.DS_Store
.AppleDouble
.LSOverride

# Environment variables
.env
.env.local
.env.development.local
.env.test.local
.env*.tmp
.env.production.local

# Build output
dist/
dist-ssr/
build/
.output/
.next/
out/
coverage/

# Python / Backend
__pycache__/
*.py[cod]
*.pyo
*.egg-info/
venv/
.venv/
backend/captures/*
!backend/captures/.gitkeep
# Station backups (Admin -> System Config -> Station Backup) are written next to the
# capture folder and include credential hashes. Never commit them, at any depth.
.bananavision-maintenance/
# Training runs from backend/scripts/train_finger_model.py (weights, plots, records).
backend/runs/
backend/app/ml/weights/*.pt
backend/app/ml/weights/*.joblib
!backend/app/ml/weights/.gitkeep
# Downloaded open-source OOD images and local evaluation reports
backend/ood-data/
backend/ood-*-report.json

# Matrix testing output
matrix_results_*.txt

# ICM project-local memory
.icm/

# Obsidian local preferences
docs/knowledge/.obsidian/

# Graphify generated outputs (if kept locally)
graphify-out/

# Claude (Codex) project-specific files
.codex/

