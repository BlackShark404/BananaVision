    <diagram name="Figure 14: IoT Hardware Integration &amp; AI Scanning Pipeline" id="iot-workflow">
        <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1620" pageHeight="700" math="0" shadow="0">
