# ── Application ──
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
APP_DEBUG=true
APP_SECRET_KEY=change-me-to-a-secure-random-string
APP_CORS_ORIGINS=["*"]

# Manual Scan Logs labels (official Windows driver; 1-10 labels per request).
BANANAVISION_PRINTER_NAME=TP870 S
BANANAVISION_LABEL_WIDTH_MM=40
BANANAVISION_LABEL_HEIGHT_MM=30

# ── Database ──
DATABASE_URL=postgresql+asyncpg://bv_user:bv_pass@localhost:5432/bananavision
DATABASE_ECHO=false

# ── Authentication ──
JWT_SECRET_KEY=your-jwt-secret-key-here
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=480
# On an empty database, set a unique temporary password (12-72 UTF-8 bytes).
# Remove this secret after the bootstrap administrator replaces it at first login.
BOOTSTRAP_ADMIN_USERNAME=admin
# BOOTSTRAP_ADMIN_PASSWORD=

# ── Camera Configuration ──
# Hardware device indices (e.g., /dev/video1). Order determines logical IDs: CAM-001, CAM-002, etc.
CAMERA_DEVICE_IDS=[0,1,2,3]
CAMERA_LABELS=["Top","Left","Right","Rear"]
CAMERA_RESOLUTION_W=1920
CAMERA_RESOLUTION_H=1080
CAMERA_WARMUP_FRAMES=30
CAMERA_CAPTURE_TIMEOUT_MS=3000
CAMERA_AUTOFOCUS=false
CAMERA_MANUAL_FOCUS_VALUE=25

# ── Sensor (Arduino DHT22) ──
SENSOR_SERIAL_PORT=/dev/ttyUSB0
SENSOR_BAUD_RATE=9600
SENSOR_READ_INTERVAL_S=5

# ── ML Models ──
YOLO_MODEL_PATH=app/ml/weights/banana_yolo26m.pt
YOLO_CONFIDENCE_THRESHOLD=0.50
YOLO_IOU_THRESHOLD=0.45
RFR_MODEL_PATH=app/ml/weights/spoilage_rfr.joblib

# ── Storage ──
CAPTURE_DIR=captures
MAX_CAPTURES_RETENTION_DAYS=30
