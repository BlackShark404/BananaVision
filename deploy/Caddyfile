# Public entry point for Tailscale Funnel.
# Run from the repository root: caddy run --config deploy/Caddyfile
# Tailscale terminates HTTPS and forwards to this HTTP listener.
{
	admin off
	auto_https off
}

# Accept any Host: Funnel forwards its public name, not 127.0.0.1.
:8080 {
	bind 127.0.0.1
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: http: https:; connect-src 'self' ws: wss:; font-src 'self' data:; object-src 'none'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
		-Server
	}

	route {
		# API documentation is not part of the public surface.
		@docs path /docs /docs/* /redoc /redoc/* /openapi.json
		respond @docs 404

		# ONE origin serves the SPA, API, evidence images and WebSocket upgrades.
		@backend path /api/* /captures/* /health
		handle @backend {
			reverse_proxy 127.0.0.1:8000
		}

		handle {
			root * frontend/dist
			try_files {path} /index.html
			file_server
		}
	}
}
