# BananaVision production settings for the public HTTPS deployment.
# Merge these keys into backend/.env; never commit that file.
# Procedure: docs/guides/remote-access.md, "Option 2 (this deployment)".
# Unlisted settings keep their defaults or the values already in backend/.env.

# ── Application ──
APP_ENV=production
APP_DEBUG=false
# The public HTTPS page is same-origin and needs no CORS entry.
# Add http://<station-host>:5173 only if operators keep using the plain-HTTP LAN page.
APP_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
# Caddy connects over loopback; trust it so audit logs record the visitor IP.
TRUSTED_PROXIES=["127.0.0.1","::1"]

# ── Signing secrets ──
# Two different secrets of at least 32 UTF-8 bytes. Production startup rejects
# placeholders, so replace both before the first run.
# Generate one: python3 -c "import base64,secrets; print(base64.b64encode(secrets.token_bytes(48)).decode())"
APP_SECRET_KEY=<48 random bytes, base64>
JWT_SECRET_KEY=<different 48 random bytes, base64>

# ── Database ──
DATABASE_URL=postgresql+asyncpg://bv_user:bv_pass@localhost:5432/bananavision
DATABASE_ECHO=false

# ── Bootstrap administrator (empty database only) ──
BOOTSTRAP_ADMIN_USERNAME=admin
# Set a unique temporary password (12-72 UTF-8 bytes), then remove the line
# after the administrator replaces it at first login.
# BOOTSTRAP_ADMIN_PASSWORD=<temporary password>

# ── Station hardware ──
# Replace with the Mini PC's real device indices and serial port.
CAMERA_DEVICE_IDS=[0,1,2,3]
SENSOR_SERIAL_PORT=/dev/ttyUSB0

# ── Storage and models ──
CAPTURE_DIR=captures
YOLO_MODEL_PATH=app/ml/weights/banana_yolov26s.pt
RFR_MODEL_PATH=app/ml/weights/spoilage_rfr.joblib
