# HTTPS pages call the same origin; a reverse proxy forwards /api and the WebSocket.
# Plain-HTTP pages call http://<hostname>:8000 unless overridden here.
# Only set these to point at a different server.
# VITE_API_URL=http://localhost:8000
# VITE_WS_URL=ws://localhost:8000
# Printed QR labels must resolve off-station. Set this to the public HTTPS origin.
# VITE_PUBLIC_BASE_URL=https://bananavision.example.ts.net
